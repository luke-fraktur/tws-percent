<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="DVORAH"
            android:textColor="#EEEBE1"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="THE VOICE OF REANIMATED ENTROPY"
            android:textColor="#A6A097"
            android:textSize="12sp"
            android:letterSpacing="0.16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="Vocais etéreos, throat-fry agressivo\ne peso industrial."
            android:textColor="#EEEBE1"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/permission_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="18dp"
            android:paddingBottom="13dp"
            android:background="@drawable/permission_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Bluetooth"
                    android:src="@drawable/ic_bluetooth" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Permissão Bluetooth necessária"
                        android:textColor="#EEEBE1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Para mostrar a bateria dos seus fones,\npermita o acesso a dispositivos próximos."
                        android:textColor="#A6A097"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/permission_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/permission_button_background"
                android:fontFamily="monospace"
                android:text="PERMITIR BLUETOOTH"
                android:textAllCaps="false"
                android:textColor="#EEEBE1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/linktree_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/social_button_background"
            android:drawableStart="@drawable/ic_linktree"
            android:drawablePadding="14dp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Linktree da Dvorah"
            android:textAllCaps="false"
            android:textColor="#EEEBE1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="linktr.ee/dvorah.ofc"
            android:textColor="#A6A097"
            android:textSize="12sp" />

        <Button
            android:id="@+id/youtube_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/social_button_background"
            android:drawableStart="@drawable/ic_youtube"
            android:drawablePadding="14dp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Canal no YouTube"
            android:textAllCaps="false"
            android:textColor="#EEEBE1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="youtube.com/@luke.fraktur"
            android:textColor="#A6A097"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#50463E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="TWS PERCENT"
            android:textColor="#EEEBE1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="Widget de bateria para seus fones"
            android:textColor="#A6A097"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
